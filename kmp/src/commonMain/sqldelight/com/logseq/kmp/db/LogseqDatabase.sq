-- Logseq Database Schema
-- Core entities for note-taking application

CREATE TABLE pages (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    uuid TEXT NOT NULL UNIQUE,
    name TEXT NOT NULL UNIQUE COLLATE NOCASE,
    namespace TEXT,
    file_path TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    properties TEXT, -- JSON string for page properties
    version INTEGER NOT NULL DEFAULT 0,
    is_favorite INTEGER DEFAULT 0,
    is_journal INTEGER DEFAULT 0,
    journal_date TEXT
);

CREATE TABLE blocks (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    uuid TEXT NOT NULL UNIQUE,
    page_id INTEGER NOT NULL,
    parent_id INTEGER,
    left_id INTEGER,
    content TEXT NOT NULL,
    level INTEGER NOT NULL DEFAULT 0,
    position INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    properties TEXT, -- JSON string for block properties
    version INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (page_id) REFERENCES pages(id) ON DELETE CASCADE,
    FOREIGN KEY (parent_id) REFERENCES blocks(id) ON DELETE CASCADE,
    FOREIGN KEY (left_id) REFERENCES blocks(id) ON DELETE SET NULL
);

CREATE TABLE properties (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    block_id INTEGER NOT NULL,
    key TEXT NOT NULL,
    value TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    FOREIGN KEY (block_id) REFERENCES blocks(id) ON DELETE CASCADE
);

CREATE TABLE plugin_data (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    plugin_id TEXT NOT NULL,
    entity_type TEXT NOT NULL,
    entity_uuid TEXT NOT NULL,
    key TEXT NOT NULL,
    value TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER,
    UNIQUE(plugin_id, entity_type, entity_uuid, key)
);

CREATE TABLE block_references (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    from_block_uuid TEXT NOT NULL,
    to_block_uuid TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    UNIQUE(from_block_uuid, to_block_uuid),
    FOREIGN KEY (from_block_uuid) REFERENCES blocks(uuid) ON DELETE CASCADE,
    FOREIGN KEY (to_block_uuid) REFERENCES blocks(uuid) ON DELETE CASCADE
);

CREATE INDEX idx_pages_uuid ON pages(uuid);
CREATE INDEX idx_pages_name ON pages(name);
CREATE INDEX idx_pages_namespace ON pages(namespace);
CREATE INDEX idx_blocks_uuid ON blocks(uuid);
CREATE INDEX idx_blocks_page_id ON blocks(page_id);
CREATE INDEX idx_blocks_parent_id ON blocks(parent_id);
CREATE INDEX idx_blocks_left_id ON blocks(left_id);
CREATE INDEX idx_blocks_level ON blocks(level);
CREATE INDEX idx_properties_block_id ON properties(block_id);
CREATE INDEX idx_properties_key ON properties(key);
CREATE INDEX idx_plugin_data_plugin_id ON plugin_data(plugin_id);
CREATE INDEX idx_plugin_data_entity ON plugin_data(entity_type, entity_uuid);
CREATE INDEX idx_plugin_data_key ON plugin_data(key);
CREATE INDEX idx_references_from ON block_references(from_block_uuid);
CREATE INDEX idx_references_to ON block_references(to_block_uuid);

-- FTS5 Full-Text Search virtual table for blocks
CREATE VIRTUAL TABLE blocks_fts USING fts5(
    content,
    content=blocks,
    content_rowid=id,
    tokenize='porter unicode61'
);

-- FTS5 triggers for automatic index synchronization
-- Insert trigger
CREATE TRIGGER blocks_ai AFTER INSERT ON blocks BEGIN
    INSERT INTO blocks_fts(rowid, content) VALUES (new.id, new.content);
END;

-- Delete trigger
CREATE TRIGGER blocks_ad AFTER DELETE ON blocks BEGIN
    INSERT INTO blocks_fts(blocks_fts, rowid, content)
    VALUES('delete', old.id, old.content);
END;

-- Update trigger
CREATE TRIGGER blocks_au AFTER UPDATE ON blocks BEGIN
    INSERT INTO blocks_fts(blocks_fts, rowid, content)
    VALUES('delete', old.id, old.content);
    INSERT INTO blocks_fts(rowid, content) VALUES (new.id, new.content);
END;

-- Repository queries

-- Block queries
selectBlockById:
SELECT * FROM blocks WHERE id = ?;

selectBlockByInternalId:
SELECT * FROM blocks WHERE id = ?;

selectBlockIdByUuid:
SELECT id FROM blocks WHERE uuid = ?;

selectPageByInternalId:
SELECT * FROM pages WHERE id = ?;

selectPageIdByUuid:
SELECT id FROM pages WHERE uuid = ?;

existsBlockById:
SELECT COUNT(*) FROM blocks WHERE id = ?;

existsBlockByUuid:
SELECT COUNT(*) FROM blocks WHERE uuid = ?;

selectAllBlocks:
SELECT * FROM blocks ORDER BY id;

selectAllBlocksPaginated:
SELECT * FROM blocks ORDER BY id LIMIT ? OFFSET ?;

selectBlockChildren:
SELECT * FROM blocks WHERE parent_id = ? ORDER BY position LIMIT ? OFFSET ?;

selectBlockChildrenByUuid:
SELECT * FROM blocks WHERE parent_id = (SELECT id FROM blocks WHERE uuid = ?) ORDER BY position;

countBlockChildren:
SELECT COUNT(*) FROM blocks WHERE parent_id = ?;

selectBlockSiblings:
SELECT * FROM blocks WHERE parent_id = (SELECT parent_id FROM blocks WHERE id = ?) AND id != ? ORDER BY position;

selectRootBlocks:
SELECT * FROM blocks WHERE parent_id IS NULL AND page_id = ? ORDER BY position LIMIT ? OFFSET ?;

countRootBlocks:
SELECT COUNT(*) FROM blocks WHERE parent_id IS NULL AND page_id = ?;

selectBlocksByPageId:
SELECT * FROM blocks WHERE page_id = ? ORDER BY position LIMIT ? OFFSET ?;

selectBlocksByPageIdUnpaginated:
SELECT * FROM blocks WHERE page_id = ? ORDER BY position;

selectBlocksByPageUuidUnpaginated:
SELECT * FROM blocks WHERE page_id = (SELECT id FROM pages WHERE uuid = ?) ORDER BY position;

selectBlocksWithContentLike:
SELECT * FROM blocks WHERE content LIKE ?;

countBlocksByPageId:
SELECT COUNT(*) FROM blocks WHERE page_id = ?;

updateBlockParent:
UPDATE blocks SET parent_id = ? WHERE id = ?;

selectBlocksByParentIdOrdered:
SELECT * FROM blocks WHERE parent_id = ? ORDER BY position;

selectBlocksByParentIds:
SELECT * FROM blocks WHERE parent_id IN ? ORDER BY parent_id, position;

selectRootBlocksByPageIdOrdered:
SELECT * FROM blocks WHERE parent_id IS NULL AND page_id = ? ORDER BY position;

selectRootBlocksByPageUuidOrdered:
SELECT * FROM blocks WHERE parent_id IS NULL AND page_id = (SELECT id FROM pages WHERE uuid = ?) ORDER BY position;

updateBlockParentPositionAndLevel:
UPDATE blocks SET parent_id = ?, position = ?, level = ? WHERE id = ?;

updateBlockHierarchy:
UPDATE blocks SET parent_id = ?, left_id = ?, position = ?, level = ? WHERE id = ?;

updateBlockPositionOnly:
UPDATE blocks SET position = ? WHERE id = ?;

updateBlockContent:
UPDATE blocks SET content = ?, updated_at = ?, version = version + 1 WHERE id = ?;

updateBlockLevelOnly:
UPDATE blocks SET level = ? WHERE id = ?;

updateBlockLeftId:
UPDATE blocks SET left_id = ? WHERE id = ?;

selectBlockByLeftId:
SELECT * FROM blocks WHERE left_id = ?;

selectLastChild:
SELECT * FROM blocks WHERE parent_id = ? ORDER BY position DESC LIMIT 1;

updateBlockProperties:
UPDATE blocks SET properties = ? WHERE id = ?;

countBlocks:
SELECT COUNT(*) FROM blocks;

deleteBlockById:
DELETE FROM blocks WHERE id = ?;

deleteBlockChildren:
DELETE FROM blocks WHERE parent_id = ?;

deleteAllBlocks:
DELETE FROM blocks;

deleteBlocksByPageId:
DELETE FROM blocks WHERE page_id = ?;

deleteBlocksByPageUuid:
DELETE FROM blocks WHERE page_id = (SELECT id FROM pages WHERE uuid = ?);

insertBlock:
INSERT INTO blocks (uuid, page_id, parent_id, left_id, content, level, position, created_at, updated_at, properties, version)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Page queries
selectPageById:
SELECT * FROM pages WHERE id = ?;

selectPageByUuid:
SELECT * FROM pages WHERE uuid = ?;

selectPageByName:
SELECT * FROM pages WHERE name = ? LIMIT 1;

existsPageById:
SELECT COUNT(*) FROM pages WHERE id = ?;

existsPageByUuid:
SELECT COUNT(*) FROM pages WHERE uuid = ?;

existsPageByName:
SELECT COUNT(*) FROM pages WHERE name = ?;

selectAllPages:
SELECT * FROM pages ORDER BY id;

selectAllPagesPaginated:
SELECT * FROM pages ORDER BY id LIMIT ? OFFSET ?;

selectPagesByNamespace:
SELECT * FROM pages WHERE namespace = ? ORDER BY name LIMIT ? OFFSET ?;

selectPagesByNamespaceUnpaginated:
SELECT * FROM pages WHERE namespace = ? ORDER BY name;

countPagesByNamespace:
SELECT COUNT(*) FROM pages WHERE namespace = ?;

selectRecentlyUpdatedPages:
SELECT * FROM pages ORDER BY updated_at DESC LIMIT ?;

selectRecentlyCreatedPages:
SELECT * FROM pages ORDER BY created_at DESC LIMIT ?;

updatePageProperties:
UPDATE pages SET properties = ? WHERE id = ?;

updatePageName:
UPDATE pages SET name = ? WHERE id = ?;

updatePage:
UPDATE pages SET 
    namespace = ?, 
    file_path = ?, 
    updated_at = ?, 
    properties = ?, 
    version = ?, 
    is_favorite = ?, 
    is_journal = ?, 
    journal_date = ?
WHERE uuid = ?;

countPages:
SELECT COUNT(*) FROM pages;

deletePageById:
DELETE FROM pages WHERE id = ?;

insertPage:
INSERT OR IGNORE INTO pages (uuid, name, namespace, file_path, created_at, updated_at, properties, version, is_favorite, is_journal, journal_date)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectJournalPages:
SELECT * FROM pages WHERE is_journal = 1 ORDER BY COALESCE(journal_date, name) DESC LIMIT ? OFFSET ?;

updatePageFavorite:
UPDATE pages SET is_favorite = ? WHERE uuid = ?;

deleteAllPages:
DELETE FROM pages;

-- Reference queries
selectOutgoingReferences:
SELECT b.* FROM blocks b
INNER JOIN block_references br ON b.uuid = br.to_block_uuid
WHERE br.from_block_uuid = ?;

selectIncomingReferences:
SELECT b.* FROM blocks b
INNER JOIN block_references br ON b.uuid = br.from_block_uuid
WHERE br.to_block_uuid = ?;

insertBlockReference:
INSERT OR REPLACE INTO block_references (from_block_uuid, to_block_uuid, created_at)
VALUES (?, ?, ?);

deleteBlockReference:
DELETE FROM block_references WHERE from_block_uuid = ? AND to_block_uuid = ?;

selectOrphanedBlocks:
SELECT b.* FROM blocks b
LEFT JOIN block_references br ON b.uuid = br.to_block_uuid
WHERE br.id IS NULL;

selectMostConnectedBlocks:
SELECT b.*, COUNT(br.id) AS reference_count
FROM blocks b
LEFT JOIN block_references br ON b.uuid = br.to_block_uuid OR b.uuid = br.from_block_uuid
GROUP BY b.id
ORDER BY reference_count DESC
LIMIT ?;

-- Search queries
selectPagesByNameLike:
SELECT * FROM pages WHERE name LIKE ?;

selectBlocksReferencing:
SELECT DISTINCT b.* FROM blocks b
INNER JOIN block_references br ON b.uuid = br.from_block_uuid
WHERE br.to_block_uuid = ?;

-- Plugin data queries
selectPluginDataById:
SELECT * FROM plugin_data WHERE id = ?;

selectPluginDataByPlugin:
SELECT * FROM plugin_data WHERE plugin_id = ? ORDER BY created_at;

selectPluginDataByEntity:
SELECT * FROM plugin_data WHERE entity_type = ? AND entity_uuid = ? ORDER BY key;

selectPluginDataByKey:
SELECT * FROM plugin_data WHERE plugin_id = ? AND key = ? ORDER BY entity_type, entity_uuid;

selectPluginDataByPluginAndEntity:
SELECT * FROM plugin_data WHERE plugin_id = ? AND entity_type = ? AND entity_uuid = ? ORDER BY key;

countPluginDataByPlugin:
SELECT COUNT(*) FROM plugin_data WHERE plugin_id = ?;

countPluginDataByEntity:
SELECT COUNT(*) FROM plugin_data WHERE entity_type = ? AND entity_uuid = ?;

insertPluginData:
INSERT INTO plugin_data (plugin_id, entity_type, entity_uuid, key, value, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

updatePluginData:
UPDATE plugin_data SET value = ?, updated_at = ? WHERE plugin_id = ? AND entity_type = ? AND entity_uuid = ? AND key = ?;

upsertPluginData:
INSERT OR REPLACE INTO plugin_data (plugin_id, entity_type, entity_uuid, key, value, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

deletePluginData:
DELETE FROM plugin_data WHERE plugin_id = ? AND entity_type = ? AND entity_uuid = ? AND key = ?;

deletePluginDataByPlugin:
DELETE FROM plugin_data WHERE plugin_id = ?;

deletePluginDataByEntity:
DELETE FROM plugin_data WHERE entity_type = ? AND entity_uuid = ?;

existsPluginData:
SELECT COUNT(*) FROM plugin_data WHERE plugin_id = ? AND entity_type = ? AND entity_uuid = ? AND key = ?;

-- FTS5 Full-Text Search queries
searchBlocksByContentFts:
SELECT
    b.id,
    b.uuid,
    b.page_id,
    b.parent_id,
    b.left_id,
    b.content,
    b.level,
    b.position,
    b.created_at,
    b.updated_at,
    b.properties,
    b.version,
    highlight(blocks_fts, 2, '<em>', '</em>') AS highlight
FROM blocks_fts bm
JOIN blocks b ON b.id = bm.rowid
WHERE blocks_fts MATCH :query || '*'
ORDER BY b.id
LIMIT :limit OFFSET :offset;

searchBlocksCountFts:
SELECT COUNT(*) AS result_count
FROM blocks_fts bm
WHERE blocks_fts MATCH :query || '*';
